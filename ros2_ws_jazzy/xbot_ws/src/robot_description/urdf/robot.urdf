      </geometry>
    </collision>
    <collision>
      <origin xyz="0.038079715 0.10327397 0.070002196" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/part_011_part.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.038079715 0.10327397 0.070002196" rpy="0 0 0" />
