  </link>
  <!-- 轮子必须用 continuous: revolute 的 ±2π 限位跑 0.216 m(2πr) 就会卡死,
       仿真里表现为"走一小段就停". 实车/RViz 不受影响 -->
  <joint name="left_joint" type="continuous">
    <origin xyz="0.011077515 0.080273973 0.0125" rpy="-1.5707963 0 0" />
    <parent link="base_link" />
    <child link="left_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="30" />
  </joint>
  <joint name="right_joint" type="continuous">
    <origin xyz="0.011077515 -0.066726027 0.0125" rpy="1.5707963 0 0" />
    <parent link="base_link" />
    <child link="right_link" />
    <!-- 右轮坐标系的 x 轴相对 base_link 转了 +90 度(镜像安装),
         所以它的转轴在自身坐标系里是 -z, 转到 base_link 下才是和左轮一致的 +y.
         如果这里写成 0 0 1, 差速插件给两轮同样的角速度时轮子会反转,
         表现为"里程计在前进, 车却在原地打转" -->
    <axis xyz="0 0 -1" />
    <limit effort="10" velocity="30" />
  </joint>
  <joint name="uni_joint" type="continuous">
    <origin xyz="0.0655737 -0.0058260145 -0.012" rpy="1.5707963 0 -0.038450944" />
    <parent link="base_link" />
    <child link="uni_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="30" />
  </joint>

  <!-- base_footprint 是机器人模型的根坐标系。运行时由里程计提供 odom 到它的变换。 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <!-- 激光雷达坐标系: 单位 m, x 向前 / y 向左 / z 向上(相对 base_link)
       实测: 前方 5 cm, 左右居中, 扫描面高 8 cm -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.05 0 0.08" rpy="0 0 0"/>
  </joint>
</robot>
