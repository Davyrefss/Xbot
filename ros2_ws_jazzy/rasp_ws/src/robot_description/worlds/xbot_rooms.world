    <!-- ================= 家具/障碍物 ================= -->
    <model name="table">
      <static>true</static>
      <pose>-4.500 3.200 0.360 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.900 0.900 0.720</size></box></geometry>
        </collision>
