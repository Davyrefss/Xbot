          <material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.55 0.35 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf">
      <static>true</static>
      <pose>5.200 4.000 0.600 0 0 0</pose>
      <link name="link">
