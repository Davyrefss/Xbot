# 默认：文本文件自动识别，仓库统一存 LF
* text=auto eol=lf

# 源码明确指定
*.c      text eol=lf
*.h      text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.urdf   text eol=lf
*.xml    text eol=lf

# 二进制文件，禁止任何转换
*.SLDPRT binary
*.SLDASM binary
*.STEP   binary
*.stp    binary
*.epro2  binary
*.eprj2  binary
*.stl    binary
*.zip    binary
*.obj    binary
*.elf    binary
*.hex    binary
*.bin    binary
